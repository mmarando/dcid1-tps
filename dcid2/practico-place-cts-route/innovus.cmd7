set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
win
restoreDesign dataout/ej2_route.enc.dat fir_serial_parallel
deleteFiller
set_analysis_view -setup func_setup_ss0p9v_125c_rcworst -hold func_hold_ff1p1v_0c_rcbest
setExtractRCMode -engine postRoute -effortLevel medium
extractRC
report_timing -late -from [get_pins {u_fir_parallel_shift_reg_reg[5][5]/Q}] -to [get_pins {u_fir_parallel_data_out_reg_reg[1][17]/D}] -max_paths 1 > reports/ej4_antes/mismo_camino.rpt
