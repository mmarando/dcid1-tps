#@(#)CDS: CPE v23.10-p004
#@(#)CDS: IQuantus/TQuantus 22.1.1-s215 (64bit) Mon Nov 20 10:05:08 PST 2023 (Linux 3.10.0-693.el7.x86_64)

set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
win
restoreDesign dataout/ej2_route.enc.dat fir_serial_parallel
deleteFiller
set_analysis_view -setup func_setup_ss0p9v_125c_rcworst -hold func_hold_ff1p1v_0c_rcbest
setExtractRCMode -engine postRoute -effortLevel medium
extractRC
report_timing -late -path_type summary_slack_only -max_paths 50 > reports/ej4_antes/timing_setup.rpt
report_timing -early -path_type summary_slack_only -max_paths 50 > reports/ej4_antes/timing_hold.rpt
report_constraint -all_violators -drv_violation_type max_transition > reports/ej4_antes/max_transition.rpt
report_area > reports/ej4_antes/area.rpt
set_analysis_view -dynamic -hold func_hold_ff1p1v_0c_rcbest -setup func_hold_ff1p1v_0c_rcbest
report_power -view func_hold_ff1p1v_0c_rcbest > reports/ej4_antes/power.rpt
